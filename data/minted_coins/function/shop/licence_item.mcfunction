# minted_coins:tmp licence = the shop licence of the bank in minted_coins:tmp bank: a paper used (like food, in a moment)
# while looking at a chest or barrel, which becomes the stock of a new shop
data modify storage minted_coins:tmp licence set value {id:"minecraft:paper",count:1,components:{"minecraft:item_name":{translate:"item.minted_coins.shop_licence",fallback:"Shop Licence"},"minecraft:lore":[{translate:"lore.minted_coins.licence_of",fallback:"Issued by %s",with:[""],color:"gray",italic:false},{translate:"lore.minted_coins.licence_use",fallback:"Use it while looking at a chest or barrel",color:"dark_gray",italic:false}],"minecraft:custom_data":{minted_coins:{licence:0}},"minecraft:custom_model_data":{strings:["minted_coins:shop_licence"]},"minecraft:consumable":{consume_seconds:0.8f,animation:"none",sound:"minecraft:item.book.page_turn",has_consume_particles:false},"minecraft:max_stack_size":16}}
data modify storage minted_coins:tmp licence.components."minecraft:lore"[0].with[0] set from storage minted_coins:tmp bank.name
data modify storage minted_coins:tmp licence.components."minecraft:custom_data".minted_coins.licence set from storage minted_coins:tmp bank.id
