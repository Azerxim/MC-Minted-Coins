# with storage minted_coins:tmp entry: appends the button of this mint to the mints list dialog;
# it opens the page of the mint (position, rates, Teleport, Edit… and Remove…), and Remove… opens a confirmation
$data modify storage minted_coins:tmp button set value {label:"",tooltip:"",width:300,action:{type:"minecraft:show_dialog",dialog:{type:"minecraft:multi_action",title:"",body:[{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.mint.position",fallback:"Position: %s %s %s (%s)",with:["$(bx)","$(by)","$(bz)","$(dim)"],color:"gray"}},{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.mint.rates",fallback:"Coins per ingot / diamond: %s",with:[],color:"gray"}}],actions:[{width:96,label:{translate:"dialog.minted_coins.mint.teleport",fallback:"Teleport",color:"aqua"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(goto)"}},{width:96,label:{translate:"dialog.minted_coins.mint.edit",fallback:"Edit…"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(edit)"}},{width:96,label:{translate:"dialog.minted_coins.mint.remove",fallback:"Remove…",color:"red"},action:{type:"minecraft:show_dialog",dialog:{type:"minecraft:confirmation",title:{translate:"dialog.minted_coins.remove.title",fallback:"Remove the mint?",color:"red"},body:{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.remove.body",fallback:"Remove the mint %s? Coins it already struck stay valid.",with:[]}},yes:{label:{translate:"dialog.minted_coins.remove.confirm",fallback:"Remove",color:"red"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(confirm)"}},no:{label:{translate:"gui.cancel",fallback:"Cancel"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set 2"}},pause:false}}}],columns:3,exit_action:{label:{translate:"gui.back",fallback:"Back"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set 2"}},pause:false}}}
data modify storage minted_coins:tmp button.label set from storage minted_coins:tmp entry.name
data modify storage minted_coins:tmp button.tooltip set from storage minted_coins:tmp joined
data modify storage minted_coins:tmp button.action.dialog.title set from storage minted_coins:tmp entry.name
data modify storage minted_coins:tmp button.action.dialog.body[1].contents.with append from storage minted_coins:tmp joined
data modify storage minted_coins:tmp button.action.dialog.actions[2].action.dialog.body.contents.with append from storage minted_coins:tmp entry.name
data modify storage minted_coins:tmp list.actions append from storage minted_coins:tmp button
