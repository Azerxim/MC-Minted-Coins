# {d, cmd, acc, page}: minted_coins:tmp show.dialog = the exchange office dialog, its inputs added by minted_coins:admin/exchange_form
$data modify storage minted_coins:tmp show.dialog set value {type:"minecraft:multi_action",title:[{text:""},{translate:"dialog.minted_coins.icon.gold",fallback:"",font:"minted_coins:dialog",color:"white",shadow_color:0},""],body:[{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.exchange_form.body",fallback:"The exchange office changes the coins of the ticked banks for coins of its bank, and back, metal by metal. For the coins given, it gives back the metal of the coins given back: 10 given and 9 given back is 10 coins for 9 between two banks at the same rate. Between different rates, the trade follows the metal of the coins (the coins each bank strikes per ingot).",color:"gray"}}],inputs:[],actions:[{label:"",tooltip:{translate:"dialog.minted_coins.exchange_form.confirm.tooltip",fallback:"Only the coins both banks strike are changed. Small coins are not."},action:{type:"minecraft:dynamic/run_command",template:'function minted_coins:$(cmd),name:"$(d)(name)",give:$(d)(give),back:$(d)(back),partners:[$(acc)]}'}}],columns:1,exit_action:{label:{translate:"gui.back",fallback:"Back"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(page)"}},pause:false}
