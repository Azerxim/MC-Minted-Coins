# with storage minted_coins:tmp m (a mint, with its trigger values goto / confirm / edit and page, the page of its bank):
# appends its button to the page of the bank; it opens the page of the mint (position, trades, Teleport, Edit… and Remove…)
$data modify storage minted_coins:tmp button set value {label:"",tooltip:"",width:300,action:{type:"minecraft:show_dialog",dialog:{type:"minecraft:multi_action",title:"",body:[{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.mint.position",fallback:"Position: %s %s %s (%s)",with:["$(bx)","$(by)","$(bz)","$(dim)"],color:"gray"}},{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.mint.trades",fallback:"Trades: %s",with:[],color:"gray"}}],actions:[{width:96,label:{translate:"dialog.minted_coins.mint.teleport",fallback:"Teleport",color:"aqua"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(goto)"}},{width:96,label:{translate:"dialog.minted_coins.mint.edit",fallback:"Edit…"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(edit)"}},{width:96,label:{translate:"dialog.minted_coins.mint.remove",fallback:"Remove…",color:"red"},action:{type:"minecraft:show_dialog",dialog:{type:"minecraft:confirmation",title:{translate:"dialog.minted_coins.remove.title",fallback:"Remove the mint?",color:"red"},body:{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.remove.body",fallback:"Remove the mint %s? Coins it already struck belong to its bank and stay valid.",with:[]}},yes:{label:{translate:"dialog.minted_coins.remove.confirm",fallback:"Remove",color:"red"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(confirm)"}},no:{label:{translate:"gui.cancel",fallback:"Cancel"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(page)"}},pause:false}}}],columns:3,exit_action:{label:{translate:"gui.back",fallback:"Back"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(page)"}},pause:false}}}
data modify storage minted_coins:tmp button.label set from storage minted_coins:tmp m.name
execute if data storage minted_coins:tmp m{kind:"exchange"} run data modify storage minted_coins:tmp button.label set value ["⇄ ",""]
execute if data storage minted_coins:tmp m{kind:"exchange"} run data modify storage minted_coins:tmp button.label[1] set from storage minted_coins:tmp m.name
data modify storage minted_coins:tmp button.tooltip set from storage minted_coins:tmp families
data modify storage minted_coins:tmp button.action.dialog.title set from storage minted_coins:tmp m.name
data modify storage minted_coins:tmp button.action.dialog.body[1].contents.with append from storage minted_coins:tmp families
data modify storage minted_coins:tmp button.action.dialog.actions[2].action.dialog.body.contents.with append from storage minted_coins:tmp m.name
data modify storage minted_coins:tmp list.actions append from storage minted_coins:tmp button
