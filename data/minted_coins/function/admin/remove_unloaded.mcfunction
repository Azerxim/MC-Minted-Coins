# with storage minted_coins:tmp entry: the mint to remove or edit is not loaded, offer to teleport to it or to forget it
$data modify storage minted_coins:tmp show.dialog set value {type:"minecraft:multi_action",title:{translate:"dialog.minted_coins.not_loaded.title",fallback:"Mint not loaded",color:"gold"},body:{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.not_loaded.body",fallback:"%s is not loaded right now. Teleport to it and try again, or forget it if it no longer exists.",with:[]}},actions:[{label:{translate:"dialog.minted_coins.mint.teleport",fallback:"Teleport",color:"aqua"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(goto)"}},{label:{translate:"dialog.minted_coins.not_loaded.forget",fallback:"Forget",color:"red"},tooltip:{translate:"dialog.minted_coins.not_loaded.forget.tooltip",fallback:"Removes the mint from the list without touching the world."},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(forget)"}}],columns:2,exit_action:{label:{translate:"gui.back",fallback:"Back"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set 2"}},pause:false}
data modify storage minted_coins:tmp show.dialog.body.contents.with append from storage minted_coins:tmp entry.name
function minted_coins:admin/show with storage minted_coins:tmp show
