# {id, page, edit, remove, new, exchange}: minted_coins:tmp list = the page of the bank without its mints, minted_coins:tmp queue = its mints,
# minted_coins:tmp bank_actions = its buttons (added after the mints by minted_coins:admin/bank_page)
data modify storage minted_coins:tmp list set value {type:"minecraft:multi_action",title:[{text:""},{translate:"dialog.minted_coins.icon.gold",fallback:"",font:"minted_coins:dialog",color:"white",shadow_color:0},{translate:"%s",with:[],color:"gold"}],body:[{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.mint.rates",fallback:"Coins per ingot / diamond: %s",with:[],color:"gray"}},{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.bank.body",fallback:"Every mint of the bank strikes its coins, under its names and at its rates, and takes back the coins of the other mints. Each mint only offers the trades chosen for it.",color:"gray"}}],actions:[],columns:1,exit_action:{label:{translate:"gui.back",fallback:"Back"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set 2"}},pause:false}
$data modify storage minted_coins:tmp bank_actions set value [{label:{translate:"dialog.minted_coins.bank.new_mint",fallback:"New mint here…",color:"green"},tooltip:{translate:"dialog.minted_coins.bank.new_mint.tooltip",fallback:"Place a mint of this bank 2 blocks in front of you and choose its trades."},width:300,action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(new)"}},{label:{translate:"dialog.minted_coins.bank.new_exchange",fallback:"New exchange office here…",color:"green"},tooltip:{translate:"dialog.minted_coins.bank.new_exchange.tooltip",fallback:"Place an exchange office of this bank 2 blocks in front of you: it changes the coins of other banks for those of this bank."},width:300,action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(exchange)"}},{label:{translate:"dialog.minted_coins.bank.edit",fallback:"Edit bank…"},tooltip:{translate:"dialog.minted_coins.bank.edit.tooltip",fallback:"Names, rates, small change and conversion order of the coins, for every mint of the bank."},width:300,action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(edit)"}},{label:{translate:"dialog.minted_coins.bank.remove",fallback:"Remove bank…",color:"red"},width:300,action:{type:"minecraft:show_dialog",dialog:{type:"minecraft:confirmation",title:{translate:"dialog.minted_coins.bank.remove.title",fallback:"Remove the bank?",color:"red"},body:{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.bank.remove.body",fallback:"Remove the bank %s and all its mints? Coins already struck keep their names, but no mint changes them or buys them back any more.",with:[]}},yes:{label:{translate:"dialog.minted_coins.remove.confirm",fallback:"Remove",color:"red"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(remove)"}},no:{label:{translate:"gui.cancel",fallback:"Cancel"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(page)"}},pause:false}}}]
data modify storage minted_coins:tmp queue set value []
$data modify storage minted_coins:tmp queue append from storage minted_coins:registry mints[{bank:$(id)}]
