# {d ("$"), cmd (the function and its first argument, e.g. "admin/mint_create {bank:3"), page (trigger value of the page of the bank)}:
# minted_coins:tmp show.dialog = the new / edit mint dialog: its name and the families of trades it accepts (all ticked)
$data modify storage minted_coins:tmp show.dialog set value {type:"minecraft:multi_action",title:[{text:""},{translate:"dialog.minted_coins.icon.gold",fallback:"",font:"minted_coins:dialog",color:"white",shadow_color:0},{translate:"%s",with:[],color:"gold"}],body:{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.mint_form.body",fallback:"The mint strikes the coins of its bank, under its names and at its rates. Choose the trades it offers: the others are left out.",color:"gray"}},inputs:[{type:"minecraft:text",key:"name",label:{translate:"dialog.minted_coins.mint_form.name",fallback:"Mint name (empty = name of the bank)"},width:240,initial:"",max_length:32},{type:"minecraft:boolean",key:"strike",label:{translate:"dialog.minted_coins.mint_form.strike",fallback:"Strike: ingots and diamonds → coins"},initial:true,on_true:"1",on_false:"0"},{type:"minecraft:boolean",key:"small",label:{translate:"dialog.minted_coins.mint_form.small",fallback:"Small change: coins ↔ small coins"},initial:true,on_true:"1",on_false:"0"},{type:"minecraft:boolean",key:"convert",label:{translate:"dialog.minted_coins.mint_form.convert",fallback:"Conversion: 64 coins ↔ 1 coin of the next order"},initial:true,on_true:"1",on_false:"0"},{type:"minecraft:boolean",key:"buyback",label:{translate:"dialog.minted_coins.mint_form.buyback",fallback:"Buyback: 9 diamond coins → 1 diamond"},initial:true,on_true:"1",on_false:"0"},{type:"minecraft:boolean",key:"purse",label:{translate:"dialog.minted_coins.mint_form.purse",fallback:"Purse: 1 leather + 1 string"},initial:true,on_true:"1",on_false:"0"},{type:"minecraft:boolean",key:"licence",label:{translate:"dialog.minted_coins.mint_form.licence",fallback:"Shop licence, at the price set by the bank"},initial:true,on_true:"1",on_false:"0"}],actions:[{label:{translate:"dialog.minted_coins.mint_form.confirm",fallback:"Save",color:"green"},tooltip:{translate:"dialog.minted_coins.mint_form.confirm.tooltip",fallback:"The trades the bank doesn't have (a coin it doesn't strike, small change it doesn't offer) are left out anyway."},action:{type:"minecraft:dynamic/run_command",template:'function minted_coins:$(cmd),name:"$(d)(name)",strike:$(d)(strike),small:$(d)(small),convert:$(d)(convert),buyback:$(d)(buyback),purse:$(d)(purse),licence:$(d)(licence)}'}}],columns:1,exit_action:{label:{translate:"gui.back",fallback:"Back"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(page)"}},pause:false}
