# with storage minted_coins:tmp m (a shop, with trigger values goto / confirm and page): its button on the page of the bank,
# opening its page (position, number of offers, Teleport and Remove…)
$data modify storage minted_coins:tmp button set value {label:["🛒 ",""],width:300,action:{type:"minecraft:show_dialog",dialog:{type:"minecraft:multi_action",title:"",body:[{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.mint.position",fallback:"Position: %s %s %s (%s)",with:["$(x)","$(y)","$(z)","$(dim)"],color:"gray"}},{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.shop.offers_count",fallback:"Offers: %s. Its stock is in the container under the merchant; the holder of its key manages it.",with:["$(offers_count)"],color:"gray"}}],actions:[{width:146,label:{translate:"dialog.minted_coins.mint.teleport",fallback:"Teleport",color:"aqua"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(goto)"}},{width:146,label:{translate:"dialog.minted_coins.mint.remove",fallback:"Remove…",color:"red"},action:{type:"minecraft:show_dialog",dialog:{type:"minecraft:confirmation",title:{translate:"dialog.minted_coins.shop.remove.title",fallback:"Remove the shop?",color:"red"},body:{type:"minecraft:plain_message",width:300,contents:{translate:"dialog.minted_coins.shop.remove.body",fallback:"The merchant leaves and the container is unlocked (when it is loaded), with everything in it. The licence is not handed back.",color:"gray"}},yes:{label:{translate:"dialog.minted_coins.remove.confirm",fallback:"Remove",color:"red"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(confirm)"}},no:{label:{translate:"gui.cancel",fallback:"Cancel"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(page)"}},pause:false}}}],columns:2,exit_action:{label:{translate:"gui.back",fallback:"Back"},action:{type:"minecraft:run_command",command:"trigger minted_coins.mint.menu set $(page)"}},pause:false}}}
data modify storage minted_coins:tmp button.label[1] set from storage minted_coins:tmp m.name
data modify storage minted_coins:tmp button.action.dialog.title set from storage minted_coins:tmp m.name
data modify storage minted_coins:tmp list.actions append from storage minted_coins:tmp button
