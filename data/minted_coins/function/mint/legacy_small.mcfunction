# as a mint, with storage minted_coins:tmp legacy_cur {metal, model, color, mint, name}: 1 small coin under the former name -> 1 current small coin
# (entries of mint.legacy saved with small:1 by earlier development versions: their small coins were named "Small %s")
$data modify storage minted_coins:tmp recipe set value {buy:{id:"minecraft:firework_star",count:1,components:{"minecraft:item_name":{translate:"item.minted_coins.small_coin",fallback:"Small %s",with:[""]},"minecraft:custom_data":{minted_coins:{mint:$(mint)}},"minecraft:custom_model_data":{strings:["minted_coins:small_$(model)"]}}},sell:{id:"minecraft:firework_star",count:1,components:{"minecraft:item_name":{translate:"item.minted_coins.small_coin",fallback:"Small %s",with:[""]},"minecraft:lore":[{translate:"lore.minted_coins.struck_by",fallback:"Struck by %s",with:[""],color:"gray",italic:false}],"minecraft:custom_data":{minted_coins:{mint:$(mint)}},"minecraft:custom_model_data":{strings:["minted_coins:small_$(model)"]},"minecraft:firework_explosion":{shape:"small_ball",colors:[I;$(color)]},"minecraft:tooltip_display":{hidden_components:["minecraft:firework_explosion"]}}},maxUses:2147483647,rewardExp:0b,xp:0,priceMultiplier:0.0f,demand:0,specialPrice:0}
data modify storage minted_coins:tmp recipe.buy.components."minecraft:item_name".with[0] set from storage minted_coins:tmp legacy_cur.name
$data modify storage minted_coins:tmp recipe.sell.components."minecraft:item_name" set from storage minted_coins:tmp small_names.$(metal)
data modify storage minted_coins:tmp recipe.sell.components."minecraft:lore"[0].with[0] set from storage minted_coins:tmp bank.name
data modify entity @s Offers.Recipes append from storage minted_coins:tmp recipe
