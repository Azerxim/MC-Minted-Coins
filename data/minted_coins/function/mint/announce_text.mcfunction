# {page}: the trigger value of the page of the bank of the new mint
$execute if data storage minted_coins:tmp mint{kind:"exchange"} run tellraw @s ["",{translate:"chat.minted_coins.exchange_created",fallback:"✔ Exchange office created: %s (%s)",color:"green",with:[{nbt:"mint.name",storage:"minted_coins:tmp",interpret:true,color:"gold"},{nbt:"bank.name",storage:"minted_coins:tmp",interpret:true,color:"gold"}]},"  ",{translate:"chat.minted_coins.open_bank",fallback:"[Bank page]",color:"aqua",click_event:{action:"run_command",command:"trigger minted_coins.mint.menu set $(page)"}}]
$execute unless data storage minted_coins:tmp mint{kind:"exchange"} run tellraw @s ["",{translate:"chat.minted_coins.mint_created",fallback:"✔ Mint created: %s (%s)",color:"green",with:[{nbt:"mint.name",storage:"minted_coins:tmp",interpret:true,color:"gold"},{nbt:"bank.name",storage:"minted_coins:tmp",interpret:true,color:"gold"}]},"  ",{translate:"chat.minted_coins.open_bank",fallback:"[Bank page]",color:"aqua",click_event:{action:"run_command",command:"trigger minted_coins.mint.menu set $(page)"}}]
