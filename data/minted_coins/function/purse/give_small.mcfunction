# {model, color, name, mint, mint_name, count}: small coins exactly like the ones the mint changes, so that they stack together
$give @s minecraft:firework_star[minecraft:item_name={translate:"item.minted_coins.small_coin",fallback:"Small %s",with:[$(name)]},minecraft:lore=[{translate:"lore.minted_coins.struck_by",fallback:"Struck by %s",with:[$(mint_name)],color:"gray",italic:false}],minecraft:custom_data={minted_coins:{mint:$(mint)}},minecraft:custom_model_data={strings:["minted_coins:$(model)"]},minecraft:firework_explosion={shape:"small_ball",colors:[I;$(color)]},minecraft:tooltip_display={hidden_components:["minecraft:firework_explosion"]}] $(count)
