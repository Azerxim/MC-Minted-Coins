{
  "type": "minecraft:multi_action",
  "title": [
    "",
    {
      "translate": "dialog.minted_coins.icon.gold",
      "fallback": "",
      "font": "minted_coins:dialog",
      "color": "white",
      "shadow_color": 0
    },
    {
      "translate": "dialog.minted_coins.menu.title",
      "fallback": "Minted Coins",
      "color": "gold"
    }
  ],
  "body": {
    "type": "minecraft:plain_message",
    "width": 300,
    "contents": {
      "translate": "dialog.minted_coins.menu.body",
      "fallback": "Banks set the coins of a currency; their mints are merchants that strike these coins from ingots. Coins can only come from a mint, so nobody can counterfeit them."
    }
  },
  "actions": [
    {
      "label": {
        "translate": "dialog.minted_coins.menu.new",
        "fallback": "New bank…"
      },
      "tooltip": {
        "translate": "dialog.minted_coins.menu.new.tooltip",
        "fallback": "Create a currency: the names and rates of its coins. Its mints are placed from its page."
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "minted_coins:bank_create"
      }
    },
    {
      "label": {
        "translate": "dialog.minted_coins.menu.list",
        "fallback": "Banks"
      },
      "tooltip": {
        "translate": "dialog.minted_coins.menu.list.tooltip",
        "fallback": "Every bank with its mints, to place a new mint, teleport to one, edit them or remove them."
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "trigger minted_coins.mint.menu set 2"
      }
    },
    {
      "label": {
        "translate": "dialog.minted_coins.menu.help",
        "fallback": "Help…"
      },
      "tooltip": {
        "translate": "dialog.minted_coins.menu.help.tooltip",
        "fallback": "How banks, mints, coins, names and editing work, and who can use this menu."
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "minted_coins:help"
      }
    }
  ],
  "columns": 1,
  "exit_action": {
    "label": {
      "translate": "dialog.minted_coins.close",
      "fallback": "Close"
    }
  },
  "pause": false
}
