{
  "type": "minecraft:multi_action",
  "title": [
    "",
    {
      "translate": "dialog.minted_coins.icon.gold",
      "fallback": "",
      "font": "minted_coins:dialog",
      "color": "white",
      "shadow_color": 0
    },
    {
      "translate": "dialog.minted_coins.menu.title",
      "fallback": "Minted Coins",
      "color": "gold"
    }
  ],
  "body": {
    "type": "minecraft:plain_message",
    "width": 300,
    "contents": {
      "translate": "dialog.minted_coins.menu.body",
      "fallback": "Mints are merchants that strike coins from ingots. Coins can only come from a mint, so nobody can counterfeit them."
    }
  },
  "actions": [
    {
      "label": {
        "translate": "dialog.minted_coins.menu.new",
        "fallback": "New mint…"
      },
      "tooltip": {
        "translate": "dialog.minted_coins.menu.new.tooltip",
        "fallback": "Place a mint 2 blocks in front of you and choose the coins it strikes."
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "minted_coins:create"
      }
    },
    {
      "label": {
        "translate": "dialog.minted_coins.menu.list",
        "fallback": "Mints list"
      },
      "tooltip": {
        "translate": "dialog.minted_coins.menu.list.tooltip",
        "fallback": "Every mint with its position and rates, to teleport to it, edit it or remove it."
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "trigger minted_coins.mint.menu set 2"
      }
    },
    {
      "label": {
        "translate": "dialog.minted_coins.menu.help",
        "fallback": "Help…"
      },
      "tooltip": {
        "translate": "dialog.minted_coins.menu.help.tooltip",
        "fallback": "How mints, coins, names and editing work, and who can use this menu."
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "minted_coins:help"
      }
    }
  ],
  "columns": 1,
  "exit_action": {
    "label": {
      "translate": "dialog.minted_coins.close",
      "fallback": "Close"
    }
  },
  "pause": false
}
