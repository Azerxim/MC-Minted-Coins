{
  "type": "minecraft:confirmation",
  "title": {
    "text": "New mint",
    "color": "gold"
  },
  "body": {
    "type": "minecraft:plain_message",
    "contents": "The mint appears 2 blocks in front of you, named after the renamed item in your main hand (otherwise \"Mint #N\").\n\nCoins are named after a renamed gold, copper or iron nugget, or renamed prismarine crystals, in your inventory (otherwise \"Gold Coin\", \"Copper Coin\", \"Iron Coin\" and \"Diamond Coin\").\n\nSet a slider to 0 and the mint won't strike that coin.\n\n9 coins always melt back into 1 ingot, and the mint buys back 9 of its own diamond coins for 1 diamond: below 9 coins, the mint keeps the difference.",
    "width": 260
  },
  "inputs": [
    {
      "type": "minecraft:number_range",
      "key": "gold",
      "label": "Gold coins per gold ingot",
      "width": 260,
      "start": 0,
      "end": 9,
      "step": 1,
      "initial": 8
    },
    {
      "type": "minecraft:number_range",
      "key": "copper",
      "label": "Copper coins per copper ingot",
      "width": 260,
      "start": 0,
      "end": 9,
      "step": 1,
      "initial": 8
    },
    {
      "type": "minecraft:number_range",
      "key": "iron",
      "label": "Iron coins per iron ingot",
      "width": 260,
      "start": 0,
      "end": 9,
      "step": 1,
      "initial": 8
    },
    {
      "type": "minecraft:number_range",
      "key": "diamond",
      "label": "Diamond coins per diamond",
      "width": 260,
      "start": 0,
      "end": 9,
      "step": 1,
      "initial": 8
    }
  ],
  "yes": {
    "label": "Create the mint",
    "action": {
      "type": "minecraft:dynamic/run_command",
      "template": "trigger minted_coins set 5$(gold)$(copper)$(iron)$(diamond)"
    }
  },
  "no": {
    "label": "Back",
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "minted_coins:menu"
    }
  },
  "pause": false
}
