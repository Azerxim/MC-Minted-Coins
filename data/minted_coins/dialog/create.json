{
  "type": "minecraft:multi_action",
  "title": [
    "",
    {
      "translate": "dialog.minted_coins.icon.gold",
      "fallback": "",
      "font": "minted_coins:dialog",
      "color": "white",
      "shadow_color": 0
    },
    {
      "translate": "dialog.minted_coins.create.title",
      "fallback": "New mint",
      "color": "gold"
    }
  ],
  "body": {
    "type": "minecraft:plain_message",
    "width": 300,
    "contents": {
      "translate": "dialog.minted_coins.create.body",
      "fallback": "The mint appears 2 blocks in front of you. An empty name is taken from a renamed item, as explained in Help…, or keeps its default. Set a slider to 0 to leave a coin out.",
      "color": "gray"
    }
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "name",
      "label": {
        "translate": "dialog.minted_coins.create.name",
        "fallback": "Mint name"
      },
      "width": 240,
      "initial": "",
      "max_length": 32
    },
    {
      "type": "minecraft:text",
      "key": "gold_name",
      "label": [
        "",
        {
          "translate": "dialog.minted_coins.create.separator",
          "fallback": "",
          "font": "minted_coins:dialog",
          "color": "gray",
          "shadow_color": 0
        },
        {
          "translate": "dialog.minted_coins.create.gold_name",
          "fallback": "Gold coin name"
        }
      ],
      "width": 240,
      "initial": "",
      "max_length": 32
    },
    {
      "type": "minecraft:number_range",
      "key": "gold",
      "label": [
        "",
        {
          "translate": "dialog.minted_coins.create.gold.icon",
          "fallback": "",
          "font": "minted_coins:dialog",
          "color": "white",
          "shadow_color": 0
        },
        {
          "translate": "dialog.minted_coins.create.gold",
          "fallback": "Gold coins per ingot"
        }
      ],
      "width": 240,
      "start": 0,
      "end": 9,
      "step": 1,
      "initial": 8
    },
    {
      "type": "minecraft:text",
      "key": "copper_name",
      "label": {
        "translate": "dialog.minted_coins.create.copper_name",
        "fallback": "Copper coin name"
      },
      "width": 240,
      "initial": "",
      "max_length": 32
    },
    {
      "type": "minecraft:number_range",
      "key": "copper",
      "label": [
        "",
        {
          "translate": "dialog.minted_coins.create.copper.icon",
          "fallback": "",
          "font": "minted_coins:dialog",
          "color": "white",
          "shadow_color": 0
        },
        {
          "translate": "dialog.minted_coins.create.copper",
          "fallback": "Copper coins per ingot"
        }
      ],
      "width": 240,
      "start": 0,
      "end": 9,
      "step": 1,
      "initial": 8
    },
    {
      "type": "minecraft:text",
      "key": "iron_name",
      "label": {
        "translate": "dialog.minted_coins.create.iron_name",
        "fallback": "Iron coin name"
      },
      "width": 240,
      "initial": "",
      "max_length": 32
    },
    {
      "type": "minecraft:number_range",
      "key": "iron",
      "label": [
        "",
        {
          "translate": "dialog.minted_coins.create.iron.icon",
          "fallback": "",
          "font": "minted_coins:dialog",
          "color": "white",
          "shadow_color": 0
        },
        {
          "translate": "dialog.minted_coins.create.iron",
          "fallback": "Iron coins per ingot"
        }
      ],
      "width": 240,
      "start": 0,
      "end": 9,
      "step": 1,
      "initial": 8
    },
    {
      "type": "minecraft:text",
      "key": "diamond_name",
      "label": {
        "translate": "dialog.minted_coins.create.diamond_name",
        "fallback": "Diamond coin name"
      },
      "width": 240,
      "initial": "",
      "max_length": 32
    },
    {
      "type": "minecraft:number_range",
      "key": "diamond",
      "label": [
        "",
        {
          "translate": "dialog.minted_coins.create.diamond.icon",
          "fallback": "",
          "font": "minted_coins:dialog",
          "color": "white",
          "shadow_color": 0
        },
        {
          "translate": "dialog.minted_coins.create.diamond",
          "fallback": "Diamond coins per diamond"
        }
      ],
      "width": 240,
      "start": 0,
      "end": 9,
      "step": 1,
      "initial": 8
    },
    {
      "type": "minecraft:boolean",
      "key": "small",
      "label": {
        "translate": "dialog.minted_coins.create.small",
        "fallback": "Small change (9 small coins = 1 coin)"
      },
      "initial": true,
      "on_true": "1",
      "on_false": "0"
    }
  ],
  "actions": [
    {
      "label": {
        "translate": "dialog.minted_coins.create.confirm",
        "fallback": "Create the mint",
        "color": "green"
      },
      "tooltip": {
        "translate": "dialog.minted_coins.create.confirm.tooltip",
        "fallback": "9 coins always melt back into 1 ingot. Below 9 per ingot, the mint keeps the difference."
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function minted_coins:admin/create {gold:$(gold),copper:$(copper),iron:$(iron),diamond:$(diamond),small:$(small),name:\"$(name)\",gold_name:\"$(gold_name)\",copper_name:\"$(copper_name)\",iron_name:\"$(iron_name)\",diamond_name:\"$(diamond_name)\"}"
      }
    }
  ],
  "columns": 2,
  "exit_action": {
    "label": {
      "translate": "gui.back",
      "fallback": "Back"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "minted_coins:menu"
    }
  },
  "pause": false
}
