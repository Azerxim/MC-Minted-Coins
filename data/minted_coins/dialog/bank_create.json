  "body": {
    "type": "minecraft:plain_message",
    "width": 300,
    "contents": {
      "translate": "dialog.minted_coins.bank_create.body",
      "fallback": "A bank sets the coins of its currency: names, rates, small change and conversion order. Its mints, placed from its page, strike them. An empty name is taken from a renamed item, as explained in Help…, or keeps its default. Set a slider to 0 to leave a coin out. Conversion order: 64 coins are worth 1 coin of the next number (0 = not converted).",
      "color": "gray"
    }
  },
