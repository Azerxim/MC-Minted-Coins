        "translate": "dialog.minted_coins.create.confirm.tooltip",
        "fallback": "9 coins always melt back into 1 ingot. Below 9 per ingot, the mint keeps the difference."
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function minted_coins:admin/bank_create {gold:$(gold),copper:$(copper),iron:$(iron),diamond:$(diamond),small:$(small),gold_rank:$(gold_rank),copper_rank:$(copper_rank),iron_rank:$(iron_rank),diamond_rank:$(diamond_rank),name:\"$(name)\",gold_name:\"$(gold_name)\",copper_name:\"$(copper_name)\",iron_name:\"$(iron_name)\",diamond_name:\"$(diamond_name)\",small_name:\"$(small_name)\",licence:$(licence),licence_metal:\"$(licence_metal)\"}"
      }
    }
