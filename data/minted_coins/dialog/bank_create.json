      "key": "name",
      "label": {
        "translate": "dialog.minted_coins.create.bank_name",
        "fallback": "Bank name"
      },
      "width": 240,
      "initial": "",
      "max_length": 32
    },
    {
      "type": "minecraft:text",
      "key": "gold_name",
