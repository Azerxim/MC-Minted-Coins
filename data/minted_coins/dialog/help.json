              "minted_coins:gold_coin"
            ]
          }
        }
      },
      "show_decorations": false,
      "show_tooltip": false,
      "description": {
        "width": 260,
        "contents": {
          "translate": "dialog.minted_coins.help.coins",
          "fallback": "Coins are named after a renamed gold, copper or iron nugget, or renamed prismarine crystals, in your inventory (otherwise \"Gold Coin\", \"Copper Coin\", \"Iron Coin\" and \"Diamond Coin\"). These items are only read, not consumed."
        }
      }
    },
    {
      "type": "minecraft:item",
      "show_decorations": false,
      "show_tooltip": false,
      "item": {
        "id": "minecraft:firework_star",
        "components": {
          "minecraft:custom_model_data": {
            "strings": [
              "minted_coins:small_gold_coin"
            ]
          },
          "minecraft:firework_explosion": {
            "shape": "small_ball",
            "colors": [
              16438858
            ]
          }
        }
      },
      "description": {
        "width": 260,
        "contents": {
